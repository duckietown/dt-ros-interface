<launch>
  <arg name="veh"/>
  <arg name="pkg_name" value="image_relayer"/>
  <arg name="node_name" default="image_relayer_node"/>
  <arg name="required" default="false" />

  <group ns="$(arg veh)">
    <node name="image_relayer_node" pkg="$(arg pkg_name)" type="$(arg node_name).py" output="screen" required="$(arg required)">
    </node>
  </group>
</launch>
