<launch>
    <arg name="veh" doc="Name of vehicle. ex megaman"/>

    <arg name="pkg_name" value="duckiematrix_interface"/>
    <arg name="node_name" value="duckiematrix_interface_node"/>

    <group ns="$(arg veh)">
        <node pkg="$(arg pkg_name)" type="$(arg node_name).py" name="$(arg node_name)" output="screen" />
    </group>
</launch>
